# Shell scripts must stay LF or bash breaks with $'\r' errors on Windows clones.
*.sh        text eol=lf
# PowerShell is fine either way; keep CRLF as the Windows convention.
*.ps1       text eol=crlf
# Markdown and config: normalize to LF in the repo.
*.md        text eol=lf
.plumblines text eol=lf
.gitignore  text eol=lf
