# Plumblines config. Read by scripts/*.sh, the PowerShell scaffolder, and CI.
# Environment variables of the same name override these values.
#
# This repo IS the framework: its source lives in scripts/, docs/, and
# templates/, not the usual src/ lib/ app/. Without this line the coverage gate
# would watch directories that don't exist here and silently enforce nothing.
agent_dir=.agent_files
src_globs=scripts/ docs/ templates/
